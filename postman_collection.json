            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"301\",\n  \"floor\": 3,\n  \"roomType\": \"DOUBLE\",\n  \"rentPerBed\": 6500,\n  \"beds\": 2\n}"
